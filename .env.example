NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:password@localhost:5432/whatsapp_fintech?schema=public

WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Paystack (funding + transfers + account resolve)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# VTPass (airtime + data) — replace with your provider
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://vtpass.com/api

APP_NAME=NairaBot
APP_BASE_URL=http://localhost:3000

MIN_FUNDING_KOBO=10000
MAX_FUNDING_KOBO=100000000
MIN_AIRTIME_KOBO=5000
MAX_AIRTIME_KOBO=5000000
MIN_TRANSFER_KOBO=10000
MAX_TRANSFER_KOBO=100000000
TRANSFER_FEE_FLAT_KOBO=1000
TRANSFER_FEE_PERCENT=0

PIN_HASH_ROUNDS=12
JWT_SECRET=change_me_to_at_least_32_characters_long_secret
LOG_LEVEL=info

# Never set true in production
SKIP_WHATSAPP_SIGNATURE=false